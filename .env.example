# ── MockInterview.ai — Root Environment Variables ─────────────────────────────
# Copy to .env (or set directly in your shell / Docker Compose).
# The backend .env.example has the full annotated list — this file is a summary.

# ── Backend ───────────────────────────────────────────────────────────────────
APP_NAME="MockInterview.ai API"
DEBUG=false
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=mock_interview_db
FRONTEND_URL=http://localhost:5173

# LLM support is optional. Leave USE_LLM=false for deterministic local mode.
USE_LLM=false
LLM_PROVIDER=gemini          # gemini | anthropic | grok | groq

GEMINI_API_KEY=               # https://aistudio.google.com/app/apikey  (recommended)
GEMINI_MODEL=gemini-2.0-flash
ANTHROPIC_API_KEY=            # https://console.anthropic.com
GROK_API_KEY=                 # https://console.x.ai
GROQ_API_KEY=                 # https://console.groq.com  (free tier)

LLM_TIMEOUT_SECONDS=15
LLM_LOG_PROMPTS=false

# Audio transcription is optional. Set false for fast heuristic mode.
ENABLE_REAL_AUDIO_TRANSCRIPTION=false
AUDIO_TRANSCRIPTION_MODEL=tiny
AUDIO_ANALYSIS_TIMEOUT_SECONDS=90

# Live job listings are optional. Without these, sample jobs are shown as SAMPLE.
ADZUNA_APP_ID=                # https://developer.adzuna.com
ADZUNA_APP_KEY=

# ── Frontend ──────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
