# ── Backend ──────────────────────────────────────────────────────────────────
APP_NAME="Intelligent Mock Interview Agent API"
DEBUG=false

# Database (optional — falls back to in-memory + disk cache if not set)
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=mock_interview_db

FRONTEND_URL=http://localhost:5173

# ── LLM Provider (optional — rule-based fallback works without this) ──────────
# Set USE_LLM=true and configure ONE provider below.
USE_LLM=false

# Option A — Anthropic Claude (default provider)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Option B — Google Gemini (free tier available at aistudio.google.com)
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=AIza...

# ── Adzuna Live Job API (optional — falls back to curated sample jobs) ────────
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
