# ── Backend ──────────────────────────────────────────────────────────────────
APP_NAME="Intelligent Mock Interview Agent API"
DEBUG=false

# MongoDB (leave as-is for local default; app falls back to in-memory if unreachable)
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=mock_interview_db

# Frontend origin allowed by CORS
FRONTEND_URL=http://localhost:5173

# Optional LLM support (leave USE_LLM=false to use rule-based analysis only)
USE_LLM=false
ANTHROPIC_API_KEY=

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
