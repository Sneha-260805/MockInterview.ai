# Backend
APP_NAME="Intelligent Mock Interview Agent API"
DEBUG=false
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=mock_interview_db
FRONTEND_URL=http://localhost:5173

# LLM support is optional. Leave USE_LLM=false for deterministic local mode.
USE_LLM=false
LLM_PROVIDER=gemini
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Audio transcription is optional. Keep false for a fast Docker demo using
# transparent heuristic audio scoring. Set true to enable Whisper if the model
# can be downloaded/loaded in your environment.
ENABLE_REAL_AUDIO_TRANSCRIPTION=true
AUDIO_TRANSCRIPTION_MODEL=tiny
AUDIO_ANALYSIS_TIMEOUT_SECONDS=90

# Live job discovery is optional. Without these, the app clearly labels sample jobs.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Frontend
VITE_API_BASE_URL=http://localhost:8000
