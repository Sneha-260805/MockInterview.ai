# ── MockInterview.ai Backend — Environment Variables ─────────────────────────
# Copy this file to .env and fill in your values.
# The app works fully without LLM (deterministic fallbacks for everything).

# ── Database ──────────────────────────────────────────────────────────────────
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=mock_interview_db

# ── Frontend ──────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── LLM Integration (optional) ───────────────────────────────────────────────
# Set USE_LLM=true and configure ONE provider to enable LLM-enhanced responses.
# If USE_LLM=false (default), all features use deterministic fallbacks — safe
# for demo and offline use.

USE_LLM=false

# Provider selection: gemini | anthropic | grok | groq
# Only the selected provider's key needs to be set.
LLM_PROVIDER=gemini

# Google Gemini — https://aistudio.google.com/app/apikey  (recommended — free tier available)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Anthropic Claude — https://console.anthropic.com
ANTHROPIC_API_KEY=

# xAI Grok — https://console.x.ai
GROK_API_KEY=
GROK_MODEL=grok-3

# Groq — https://console.groq.com  (free tier)
GROQ_API_KEY=
GROQ_MODEL=mixtral-8x7b-32768

# LLM request settings
LLM_TIMEOUT_SECONDS=15     # hard per-request timeout; 0 = no timeout
LLM_LOG_PROMPTS=false      # set true to log full prompts/responses to stdout (debug only)

# ── Audio Transcription (optional) ────────────────────────────────────────────
# Set false for fast demo using heuristic audio scoring.
# Set true to enable faster-Whisper (model is downloaded on first run).
ENABLE_REAL_AUDIO_TRANSCRIPTION=false
AUDIO_TRANSCRIPTION_MODEL=tiny
AUDIO_ANALYSIS_TIMEOUT_SECONDS=90

# ── Adzuna Job Search API (optional) ─────────────────────────────────────────
# Without these, the app uses sample jobs clearly labelled as SAMPLE.
# Register at https://developer.adzuna.com to get free API credentials.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
